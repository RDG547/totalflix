# Variáveis NEXT_PUBLIC_* são enviadas ao navegador. Não coloque segredos nelas.

# TMDB - catálogo principal
NEXT_PUBLIC_TMDB_API_KEY=your-tmdb-api-key
NEXT_PUBLIC_TMDB_BASE_URL=https://api.themoviedb.org/3
NEXT_PUBLIC_TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# OMDb - metadados complementares
NEXT_PUBLIC_OMDB_API_KEY=your-omdb-api-key
NEXT_PUBLIC_OMDB_BASE_URL=https://www.omdbapi.com

# Firebase Web SDK - configuração pública do aplicativo
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-firebase-app-id
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Players com endpoint configurável (opcionais; os valores abaixo são os fallbacks)
NEXT_PUBLIC_MEGA_EMBED_URL=https://megaembed.com
NEXT_PUBLIC_2EMBED_URL=https://www.2embed.cc/embed

# Softurl - encurtador usado pelo Link Gate (monetização). Somente servidor,
SOFTURL_API_TOKEN=your-softurl-api-token

